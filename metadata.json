{
  "name": "miharp-mattermost",
  "version": "0.1.0",
  "author": "Mike Harp",
  "summary": "Installs and configures a Mattermost server from the official apt repository",
  "license": "Apache-2.0",
  "source": "https://github.com/miharp/puppet-mattermost",
  "project_page": "https://github.com/miharp/puppet-mattermost",
  "issues_url": "https://github.com/miharp/puppet-mattermost/issues",
  "dependencies": [
    {
      "name": "puppetlabs/stdlib",
      "version_requirement": ">= 9.0.0 < 10.0.0"
    },
    {
      "name": "puppetlabs/apt",
      "version_requirement": ">= 9.0.0 < 11.0.0"
    }
  ],
  "operatingsystem_support": [
    {
      "operatingsystem": "Ubuntu",
      "operatingsystemrelease": [
        "20.04",
        "22.04",
        "24.04"
      ]
    }
  ],
  "requirements": [
    {
      "name": "puppet",
      "version_requirement": ">= 7.24 < 9.0.0"
    },
    {
      "name": "openvox",
      "version_requirement": ">= 7.24 < 9.0.0"
    }
  ]
}
